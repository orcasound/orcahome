# Sanity headless CMS (Phase 1 — #317)
# Copy to .env.local and fill in. .env.local is gitignored.

# Public project info (safe to expose to the browser).
NEXT_PUBLIC_SANITY_PROJECT_ID=tncpl9l7
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Server-only token used to read DRAFT (unpublished) content in draft mode.
# Create one at https://www.sanity.io/manage (project Orcahome) → API → Tokens,
# role "Viewer". Never commit the real value.
SANITY_API_READ_TOKEN=

# Optional: if set, /api/draft-mode/enable requires ?secret=<this value>.
SANITY_PREVIEW_SECRET=

# MOA join / change-request forms on /getinvolved.
# NEXT_PUBLIC_* values are inlined at build time; changing them requires a rebuild/redeploy.
# Submission handler: `mailto` (default, opens the visitor's email app) or
# `console` (development only; logs and sends nothing).
NEXT_PUBLIC_MOA_SUBMISSION_HANDLER=
# Recipient for the mailto handler. Defaults to info@orcasound.net.
NEXT_PUBLIC_MOA_SUBMISSION_EMAIL=
