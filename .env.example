# Sanity headless CMS (Phase 1 — #317)
# Copy to .env.local and fill in. .env.local is gitignored.

# Public project info (safe to expose to the browser).
NEXT_PUBLIC_SANITY_PROJECT_ID=tncpl9l7
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Server-only token used to read DRAFT (unpublished) content in draft mode.
# Create one at https://www.sanity.io/manage (project Orcahome) → API → Tokens,
# role "Viewer". Never commit the real value.
SANITY_API_READ_TOKEN=

# Optional: if set, /api/draft-mode/enable requires ?secret=<this value>.
SANITY_PREVIEW_SECRET=

# Research panel signup endpoint: where the opt-in form POSTs. The handler in
# src/server/research-panel.js has to be hosted outside the static site; until
# this is set, the form shows that signup is unavailable.
NEXT_PUBLIC_RESEARCH_PANEL_URL=
